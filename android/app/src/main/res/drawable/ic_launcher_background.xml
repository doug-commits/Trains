<?xml version="1.0" encoding="utf-8"?>
<!-- Not a flat square. A launcher is a grid of small bright things and a plain
     fill disappears into it; the gradient runs the same way the mark does, dark
     at the foot where the sea is and lighter at the head where the rail starts,
     so the icon has a direction even at 48dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="54" android:startY="0"
          android:endX="54" android:endY="108">
        <item android:offset="0" android:color="#12303C"/>
        <item android:offset="0.55" android:color="#0A191F"/>
        <item android:offset="1" android:color="#061217"/>
      </gradient>
    </aapt:attr>
  </path>
</vector>
