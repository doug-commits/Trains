<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The page follows the system theme on its own; this only keeps the window
       and the bars behind it in step, so a dark-mode launch never flashes. -->
  <style name="Theme.Overland" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/sea</item>
    <item name="android:statusBarColor">@color/sea</item>
    <item name="android:navigationBarColor">@color/sea</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
</resources>
