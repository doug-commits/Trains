<?xml version="1.0" encoding="utf-8"?>
<!-- The thesis of the whole thing, in one mark: rail while there is land, and a
     boat where the land ends.

     A track runs down the icon on its sleepers in the same amber the map draws
     rail in, stops, and carries on as two dashes in the same teal the map draws
     a ferry in. That is exactly what the legend says and exactly what a journey
     from Bangkok to Bali looks like.

     Everything sits inside the 66dp circle that every launcher mask is
     guaranteed to leave alone — the mark spans y 24 to 85 against a boundary at
     21 and 87, and the widest sleeper corner is 31.4 from centre against a
     radius of 33. Nothing here can be clipped into nonsense by a round mask, a
     squircle or a teardrop. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

  <!-- Sleepers. Wider than the rail and cooler than it, so the rail reads as
       something laid on top rather than part of the same object. -->
  <path android:fillColor="#8CA9B0" android:pathData="M38,27.5h32v5h-32z"/>
  <path android:fillColor="#8CA9B0" android:pathData="M38,37.5h32v5h-32z"/>
  <path android:fillColor="#8CA9B0" android:pathData="M38,47.5h32v5h-32z"/>
  <path android:fillColor="#8CA9B0" android:pathData="M38,57.5h32v5h-32z"/>

  <!-- The rail. The one warm line on the mark, and the one that stops. -->
  <path android:fillColor="#E9A63E" android:pathData="M49,24h10v42h-10z"/>

  <!-- And the sea it becomes. Dashed, because that is how the map draws it. -->
  <path android:fillColor="#57B6C8" android:pathData="M49,71h10v6h-10z"/>
  <path android:fillColor="#57B6C8" android:pathData="M49,81h10v4h-10z"/>
</vector>
