<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Overland SEA</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Both written by tools/build-ios.mjs, from the same source as Android's:
       package.json for the marketing version, ten-minute ticks for the build
       number, which App Store Connect requires to rise on every upload. -->
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <!-- Full bleed, so env(safe-area-inset-*) in the stylesheet returns the real
       numbers. Without this the map still fills the screen but the sheet's
       handle sits under the home indicator and the top bar under the notch. -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- The web view decides this per frame from the map's own background, so
       the bar stays legible when the reader switches theme. -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>

  <!-- Location, when the reader taps the location button and never at launch
       (see LocationBridge.swift). Nothing else: no camera, contacts,
       microphone, photos, or tracking. A usage description appearing here
       without a matching change to the privacy policy means one of the two is
       wrong. -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Your position is shown on the map with the distance to the nearest station, or to where your journey starts. It is not sent anywhere or stored.</string>

  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
