<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Only the window background, which is what shows for the instant before
       the page paints. The bar colours that used to be here are gone: the
       platform has ignored them since targetSdk 35, and MainActivity now
       paints those strips from the page's own palette, which is the only
       thing that knows whether the reader chose light or dark in the app. -->
  <style name="Theme.Overland" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/sea</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
</resources>
