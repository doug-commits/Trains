node_modules/
shots/
dist/
public/

# Android. The assets are staged from the built page by tools/build-android.mjs
# — 22 MB of generated copies of files already in the repo, regenerated by CI on
# every build. Committing them would double the clone for nothing.
android/app/src/main/assets/
android/app/build/
android/.gradle/
android/local.properties
android/version.properties

# iOS. The project is generated from ios/project.yml by XcodeGen, the page is
# staged by tools/build-ios.mjs, and the version is stamped from the clock.
# Committing any of the three would mean the repository carries a second copy
# of something already in it, and the copy is the one that goes stale.
ios/Overland.xcodeproj/
ios/Overland/Resources/www/
ios/Version.xcconfig
ios/build/
